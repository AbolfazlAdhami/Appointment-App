{
  "name": "@appointment/api",
  "version": "0.1.0",
  "private": true,
  "description": "Appointment App REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@appointment/types": "0.1.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
