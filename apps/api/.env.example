# Environment
NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to use credentialed API requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/pezeshki

# Authentication
JWT_SECRET=replace-with-a-secure-random-secret
OTP_SECRET=replace-with-at-least-32-characters-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800

# OTP Configuration
OTP_EXPIRES_IN_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT=10

# SMS Provider
SMS_PROVIDER=mock
LIMOSMS_API_KEY=
LIMOSMS_SENDER_NUMBER=