generator client {
        provider = "prisma-client"
        output   = "../src/generated/prisma"
}

datasource db {
        provider = "postgresql"
}

// ======================
// ENUMS
// ======================

enum Role {
        PATIENT
        DOCTOR
        ADMIN
}

enum AppointmentStatus {
        PENDING
        CONFIRMED
        COMPLETED
        CANCELLED
        NO_SHOW
}

enum DayOfWeek {
        MONDAY
        TUESDAY
        WEDNESDAY
        THURSDAY
        FRIDAY
        SATURDAY
        SUNDAY
}

// ======================
// MODELS
// ======================

model User {
        id        String   @id @default(cuid())
        email     String   @unique
        password  String
        firstName String
        lastName  String
        phone     String?
        avatarUrl String?
        role      Role     @default(PATIENT)
        isActive  Boolean  @default(true)
        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        // Relations
        doctorProfile  DoctorProfile?
        patientProfile PatientProfile?

        // Appointments as patient
        patientAppointments Appointment[] @relation("PatientAppointments")

        // Appointments as doctor
        doctorAppointments Appointment[] @relation("DoctorAppointments")

        @@index([email])
        @@index([role])
}

model DoctorProfile {
        id     String @id @default(cuid())
        userId String @unique
        user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

        specialization  String
        about           String?  @db.Text // Introduction / about the doctor
        experienceYears Int?
        education       String?  @db.Text
        languages       String[] // e.g. ["English", "Arabic"]
        consultationFee Decimal? @db.Decimal(10, 2)
        isVerified      Boolean  @default(false)
        isAvailable     Boolean  @default(true) // Can the doctor currently accept bookings?

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        // Weekly recurring availability
        weeklyAvailabilities DoctorWeeklyAvailability[]

        // Specific date overrides / blocks (optional but useful)
        availabilityOverrides AvailabilityOverride[]

        @@index([specialization])
        @@index([isVerified, isAvailable])
}

model PatientProfile {
        id     String @id @default(cuid())
        userId String @unique
        user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

        dateOfBirth        DateTime?
        gender             String?
        bloodType          String?
        allergies          String?   @db.Text
        chronicDiseases    String?   @db.Text // Short history of diseases
        currentMedications String?   @db.Text // Current medications
        emergencyContact   String?
        notes              String?   @db.Text // General notes

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt
}

// ======================
// AVAILABILITY
// ======================

// Recurring weekly schedule (e.g. Monday 09:00-12:00 and 16:00-20:00)
model DoctorWeeklyAvailability {
        id              String        @id @default(cuid())
        doctorProfileId String
        doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

        dayOfWeek       DayOfWeek
        startTime       String // "09:00" (24h format)
        endTime         String // "12:00"
        slotDurationMin Int       @default(60) // 1-hour slots by default
        isActive        Boolean   @default(true)

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        @@unique([doctorProfileId, dayOfWeek, startTime, endTime])
        @@index([doctorProfileId, dayOfWeek])
}

// Optional: specific date overrides (holidays, extra hours, blocked days)
model AvailabilityOverride {
        id              String        @id @default(cuid())
        doctorProfileId String
        doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

        date        DateTime @db.Date
        isAvailable Boolean // false = fully blocked that day
        startTime   String? // if available only partial day
        endTime     String?
        reason      String?

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        @@unique([doctorProfileId, date])
        @@index([doctorProfileId, date])
}

// ======================
// APPOINTMENTS
// ======================

model Appointment {
        id String @id @default(cuid())

        patientId String
        patient   User   @relation("PatientAppointments", fields: [patientId], references: [id])

        doctorId String
        doctor   User   @relation("DoctorAppointments", fields: [doctorId], references: [id])

        startTime DateTime // Exact start datetime
        endTime   DateTime // Exact end datetime (usually +60 min)

        status AppointmentStatus @default(PENDING)
        reason String? // Why the patient is coming
        notes  String?           @db.Text // Patient notes when booking

        // Visit history / doctor's notes after the appointment
        visitNotes   String?   @db.Text
        diagnosis    String?   @db.Text
        prescription String?   @db.Text
        followUpDate DateTime?

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        @@unique([doctorId, startTime]) // Prevent double booking for the same doctor + time
        @@index([patientId, startTime])
        @@index([doctorId, startTime])
        @@index([status, startTime])
}
