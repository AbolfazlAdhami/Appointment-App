generator client {
        provider = "prisma-client"
        output   = "../src/generated/prisma"
}

datasource db {
        provider = "postgresql"
}

// #############
// ENUMS
// #############
enum Role {
        PATIENT
        DOCTOR
        ADMIN
}

enum OtpPurpose {
        SIGNUP
        LOGIN
        PHONE_VERIFICATION
        PASSWORD_RESET
}

enum OtpChannel {
        SMS
        EMAIL
}

enum NationalIdChangeStatus {
        PENDING
        APPROVED
        REJECTED
        CANCELLED
}

enum AuditActorType {
        USER
        ADMIN
        SYSTEM
        EXTERNAL_SERVICE
}

enum AuditOutcome {
        SUCCESS
        FAILURE
}

enum SecurityEventType {
        LOGIN_SUCCESS
        LOGIN_FAILURE
        LOGOUT
        OTP_FAILURE
        PASSWORD_CHANGED
        ACCOUNT_LOCKED
        SUSPICIOUS_ACTIVITY
        SESSION_REVOKED
}

enum DoctorCredentialType {
        MEDICAL_LICENSE
        MEDICAL_COUNCIL_CARD
        EDUCATION_CERTIFICATE
        CV
        ID_DOCUMENT
        OTHER
}

enum CredentialStatus {
        PENDING_REVIEW
        APPROVED
        REJECTED
        NEEDS_CORRECTION
        EXPIRED
}

enum CredentialReviewDecision {
        APPROVED
        REJECTED
        NEEDS_CORRECTION
}

enum DoctorVerificationStatus {
        DRAFT
        PENDING_REVIEW
        NEEDS_CORRECTION
        APPROVED
        REJECTED
        SUSPENDED
}

enum MedicalHistoryStatus {
        ACTIVE
        RESOLVED
        INACTIVE
}

enum AllergySeverity {
        MILD
        MODERATE
        SEVERE
        LIFE_THREATENING
        UNKNOWN
}

enum AllergyStatus {
        ACTIVE
        INACTIVE
        UNCONFIRMED
}

enum MedicationStatus {
        ACTIVE
        COMPLETED
        DISCONTINUED
        ON_HOLD
}

enum FamilyRelation {
        MOTHER
        FATHER
        SISTER
        BROTHER
        CHILD
        MATERNAL_GRANDMOTHER
        MATERNAL_GRANDFATHER
        PATERNAL_GRANDMOTHER
        PATERNAL_GRANDFATHER
        OTHER
        UNKNOWN
}

enum AppointmentType {
        REGULAR
        URGENT
        PRE_OPERATIVE
        POST_OPERATIVE
        FOLLOW_UP
        CONSULTATION
}

enum ConsultationMode {
        IN_PERSON
        ONLINE
}

enum AvailabilityOverrideType {
        AVAILABLE
        UNAVAILABLE
}

enum RescheduleStatus {
        REQUESTED
        ACCEPTED
        REJECTED
        CANCELLED
}

enum WaitlistStatus {
        ACTIVE
        OFFERED
        BOOKED
        CANCELLED
        EXPIRED
}

enum DayOfWeek {
        SATURDAY
        SUNDAY
        MONDAY
        TUESDAY
        WEDNESDAY
        THURSDAY
        FRIDAY
}

enum AppointmentStatus {
        PENDING_PAYMENT
        CONFIRMED
        COMPLETED
        CANCELLED
        NO_SHOW
}

enum AppointmentOfferStatus {
        PENDING
        ACCEPTED
        DECLINED
        EXPIRED
        CANCELLED
}

// #############
//  Auth Models
// #############

model User {
        id            String    @id @default(cuid())
        firstName     String
        lastName      String
        nationalId    String    @unique
        dateOfBirth   DateTime  @db.Date
        phone         String    @unique
        phoneVerified DateTime?

        email             String?   @unique
        emailVerifiedAt   DateTime?
        passwordHash      String?
        passwordChangedAt DateTime?

        role        Role      @default(PATIENT)
        isActive    Boolean   @default(true)
        lastLoginAt DateTime?
        createdAt   DateTime  @default(now())
        updatedAt   DateTime  @updatedAt

        avatarFileId String?    @unique
        avatarFile   FileAsset? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

        doctorProfile  DoctorProfile?
        patientProfile PatientProfile?

        sessions            AuthSession[]
        otpChallenges       OtpChallenge[]
        passwordResetTokens PasswordResetToken[]

        nationalIdChangeRequests   NationalIdChangeRequest[] @relation("NationalIdChangeOwner")
        reviewedNationalIdRequests NationalIdChangeRequest[] @relation("NationalIdChangeReviewer")

        auditEvents    AuditLog[]      @relation("AuditActor")
        securityEvents SecurityEvent[]

        ownedFiles FileAsset[] @relation("FileOwner")

        reviewedDoctorProfiles    DoctorProfile[]          @relation("DoctorProfileReviewer")
        reviewedDoctorCredentials DoctorCredentialReview[] @relation("CredentialReviewer")

        @@index([role, isActive])
        @@index([createdAt])
}

model AuthSession {
        id               String    @id @default(cuid())
        userId           String
        refreshTokenHash String    @unique
        expiresAt        DateTime
        revokedAt        DateTime?
        lastUsedAt       DateTime?
        createdAt        DateTime  @default(now())

        user User @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@index([userId, revokedAt])
        @@index([expiresAt])
}

model OtpChallenge {
        id          String     @id @default(cuid())
        userId      String?
        channel     OtpChannel
        purpose     OtpPurpose
        destination String
        codeHash    String
        attempts    Int        @default(0)
        maxAttempts Int        @default(5)
        expiresAt   DateTime
        consumedAt  DateTime?
        createdAt   DateTime   @default(now())

        user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

        @@index([destination, purpose, createdAt])
        @@index([expiresAt, consumedAt])
}

model PasswordResetToken {
        id        String    @id @default(cuid())
        userId    String
        tokenHash String    @unique
        expiresAt DateTime
        usedAt    DateTime?
        createdAt DateTime  @default(now())

        user User @relation(fields: [userId], references: [id], onDelete: Cascade)

        @@index([userId, expiresAt])
}

model NationalIdChangeRequest {
        id                  String                 @id @default(cuid())
        userId              String
        requestedNationalId String                 @unique
        reason              String?
        status              NationalIdChangeStatus @default(PENDING)

        reviewedById String?
        reviewNote   String?
        reviewedAt   DateTime?
        createdAt    DateTime  @default(now())
        updatedAt    DateTime  @updatedAt

        user       User  @relation("NationalIdChangeOwner", fields: [userId], references: [id], onDelete: Restrict)
        reviewedBy User? @relation("NationalIdChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

        @@index([userId, status])
        @@index([status, createdAt])
}

model FileAsset {
        id           String   @id @default(cuid())
        ownerUserId  String?
        storageKey   String   @unique
        originalName String
        mimeType     String
        sizeBytes    BigInt
        checksum     String?
        isPrivate    Boolean  @default(true)
        createdAt    DateTime @default(now())

        owner User? @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

        avatarFor         User?              @relation("UserAvatar")
        doctorCredentials DoctorCredential[]

        @@index([ownerUserId, createdAt])
}

model AuditLog {
        id          String         @id @default(cuid())
        actorUserId String?
        actorType   AuditActorType
        action      String
        entityType  String
        entityId    String?
        outcome     AuditOutcome   @default(SUCCESS)
        reason      String?
        changes     Json?
        requestId   String?
        ipAddress   String?
        createdAt   DateTime       @default(now())
        actor       User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

        @@index([entityType, entityId, createdAt])
        @@index([actorUserId, createdAt])
        @@index([action, createdAt])
        @@index([requestId])
}

model SecurityEvent {
        id        String            @id @default(cuid())
        userId    String?
        eventType SecurityEventType
        success   Boolean
        ipAddress String?
        userAgent String?
        requestId String?
        details   Json?
        createdAt DateTime          @default(now())

        user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

        @@index([userId, createdAt])
        @@index([eventType, createdAt])
}

// #############
//  Patient Profile Models
// #############

model PatientProfile {
        id                    String   @id @default(cuid())
        userId                String   @unique
        emergencyContactName  String?
        emergencyContactPhone String?
        createdAt             DateTime @default(now())
        updatedAt             DateTime @updatedAt

        medicalHistories PatientMedicalHistory[]
        allergies        PatientAllergy[]
        medications      PatientMedication[]
        familyHistories  PatientFamilyHistory[]

        appointments    Appointment[]
        waitlistEntries WaitlistEntry[]

        user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PatientMedicalHistory {
        id               String               @id @default(cuid())
        patientProfileId String
        conditionName    String
        description      String?
        diagnosedAt      DateTime?            @db.Date
        resolvedAt       DateTime?            @db.Date
        status           MedicalHistoryStatus @default(ACTIVE)
        notes            String?
        createdAt        DateTime             @default(now())
        updatedAt        DateTime             @updatedAt
        patientProfile   PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        @@index([patientProfileId, status])
        @@index([patientProfileId, conditionName])
}

model PatientAllergy {
        id               String          @id @default(cuid())
        patientProfileId String
        allergen         String
        reaction         String?
        severity         AllergySeverity @default(UNKNOWN)
        status           AllergyStatus   @default(ACTIVE)
        diagnosedAt      DateTime?       @db.Date
        notes            String?
        createdAt        DateTime        @default(now())
        updatedAt        DateTime        @updatedAt
        patientProfile   PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        @@index([patientProfileId, status])
        @@index([patientProfileId, allergen])
}

model PatientMedication {
        id               String           @id @default(cuid())
        patientProfileId String
        medicationName   String
        activeIngredient String?
        dosage           String?
        route            String?
        frequency        String?
        instructions     String?
        startedAt        DateTime?        @db.Date
        endedAt          DateTime?        @db.Date
        status           MedicationStatus @default(ACTIVE)
        prescribedBy     String?
        notes            String?
        createdAt        DateTime         @default(now())
        updatedAt        DateTime         @updatedAt
        patientProfile   PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        @@index([patientProfileId, status])
        @@index([patientProfileId, medicationName])
}

model PatientFamilyHistory {
        id               String         @id @default(cuid())
        patientProfileId String
        relation         FamilyRelation @default(UNKNOWN)
        conditionName    String
        ageAtDiagnosis   Int?
        isDeceased       Boolean?
        notes            String?
        createdAt        DateTime       @default(now())
        updatedAt        DateTime       @updatedAt

        patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        @@index([patientProfileId, relation])
        @@index([patientProfileId, conditionName])
}

// #############
// Doctor Models
// #############

model DoctorProfile {
        id                 String                   @id @default(cuid())
        userId             String                   @unique
        headline           String?
        shortIntroduction  String?
        biography          String?
        yearsOfExperience  Int?
        videoUrl           String?
        verificationStatus DoctorVerificationStatus @default(DRAFT)
        submittedAt        DateTime?
        reviewedAt         DateTime?
        reviewedById       String?
        reviewNote         String?
        isPublished        Boolean                  @default(false)
        createdAt          DateTime                 @default(now())
        updatedAt          DateTime                 @updatedAt

        user User @relation(fields: [userId], references: [id], onDelete: Restrict)

        reviewedByt User? @relation("DoctorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

        services              DoctorService[]
        weeklyAvailability    DoctorWeeklyAvailability[]
        availabilityOverrides AvailabilityOverride[]
        appointments          Appointment[]
        waitlistEntries       WaitlistEntry[]

        specialties DoctorSpecialty[]
        credentials DoctorCredential[]

        @@index([verificationStatus, isPublished])
}

model Specialty {
        id          String  @id @default(cuid())
        name        String
        slug        String  @unique
        description String?
        isActive    Boolean @default(true)
        sortOrder   Int     @default(0)

        doctorSpecialties DoctorSpecialty[]

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        @@index([isActive, sortOrder])
}

model DoctorSpecialty {
        id              String   @id @default(cuid())
        doctorProfileId String
        specialtyId     String
        isPrimary       Boolean  @default(false)
        createdAt       DateTime @default(now())

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

        @@unique([doctorProfileId, specialtyId])
        @@index([specialtyId])
        @@index([doctorProfileId, isPrimary])
}

model DoctorCredential {
        id               String               @id @default(cuid())
        doctorProfileId  String
        fileAssetId      String               @unique
        type             DoctorCredentialType
        title            String
        issuingAuthority String?
        credentialNumber String?
        issuedAt         DateTime?            @db.Date
        expiresAt        DateTime?            @db.Date
        status           CredentialStatus     @default(PENDING_REVIEW)
        submittedAt      DateTime             @default(now())
        reviewedAt       DateTime?
        reviewNote       String?
        createdAt        DateTime             @default(now())
        updatedAt        DateTime             @updatedAt

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
        fileAsst      FileAsset     @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

        reviews DoctorCredentialReview[]

        @@index([doctorProfileId, type])
        @@index([doctorProfileId, status])
        @@index([status, submittedAt])
        @@index([expiresAt])
}

model DoctorCredentialReview {
        id           String                   @id @default(cuid())
        credentialId String
        reviewerId   String
        decision     CredentialReviewDecision
        note         String?
        createdAt    DateTime                 @default(now())

        credential DoctorCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

        reviewer User @relation("CredentialReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

        @@index([credentialId, createdAt])
        @@index([reviewerId, createdAt])
}

model DoctorService {
        id               String           @id @default(cuid())
        doctorProfileId  String
        name             String
        description      String?
        appointmentType  AppointmentType  @default(REGULAR)
        consultationMode ConsultationMode
        durationMinutes  Int
        price            Decimal          @db.Decimal(12, 2)
        currency         String           @default("IRR")
        isActive         Boolean          @default(true)
        createdAt        DateTime         @default(now())
        updatedAt        DateTime         @updatedAt

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        appointments    Appointment[]
        waitlistEntries WaitlistEntry[]
        offers          AppointmentOffer[]

        @@index([doctorProfileId, isActive])
        @@index([doctorProfileId, appointmentType])
}

model DoctorWeeklyAvailability {
        id              String    @id @default(cuid())
        doctorProfileId String
        dayOfWeek       DayOfWeek
        startMinute     Int
        endMinute       Int
        timezone        String    @default("Asia/Tehran")
        isActive        Boolean   @default(true)
        createdAt       DateTime  @default(now())
        updatedAt       DateTime  @updatedAt

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        @@index([doctorProfileId, dayOfWeek, isActive])
}

// #############
//  Appointment Models
// #############

model Appointment {
        id               String @id @default(cuid())
        patientProfileId String
        doctorProfileId  String
        doctorServiceId  String

        appointmentType  AppointmentType
        consultationMode ConsultationMode
        status           AppointmentStatus @default(PENDING_PAYMENT)

        startsAt DateTime
        endsAt   DateTime
        timezone String   @default("Asia/Tehran")

        bookedDurationMinutes Int
        price                 Decimal @db.Decimal(12, 2)
        currency              String  @default("IRR")

        paymentHoldExpiresAt       DateTime?
        confirmedAt                DateTime?
        cancelledAt                DateTime?
        cancellationReason         String?
        cancellationPolicySnapshot Json?

        patientNotes String?
        doctorNotes  String?

        createdAt DateTime @default(now())
        updatedAt DateTime @updatedAt

        patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        doctorService DoctorService @relation(fields: [doctorServiceId], references: [id], onDelete: Restrict)

        reschedules AppointmentReschedule[]

        @@index([patientProfileId, startsAt])
        @@index([doctorProfileId, startsAt, endsAt])
        @@index([doctorProfileId, status, startsAt])
        @@index([status, paymentHoldExpiresAt])
}

model WaitlistEntry {
        id               String         @id @default(cuid())
        patientProfileId String
        doctorProfileId  String
        doctorServiceId  String
        desiredFrom      DateTime?
        desiredUntil     DateTime?
        status           WaitlistStatus @default(ACTIVE)
        notes            String?
        createdAt        DateTime       @default(now())
        updatedAt        DateTime       @updatedAt

        patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        doctorService DoctorService @relation(fields: [doctorServiceId], references: [id], onDelete: Restrict)

        offers AppointmentOffer[]

        @@index([doctorProfileId, status, desiredFrom])
        @@index([patientProfileId, status])
}

model AppointmentReschedule {
        id                String           @id @default(cuid())
        appointmentId     String
        requestedStartsAt DateTime
        requestedEndsAt   DateTime
        status            RescheduleStatus @default(REQUESTED)
        reason            String?
        responseNote      String?
        respondedAt       DateTime?
        createdAt         DateTime         @default(now())
        updatedAt         DateTime         @updatedAt

        appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

        @@index([appointmentId, createdAt])
        @@index([status, createdAt])
}

model AvailabilityOverride {
        id              String                   @id @default(cuid())
        doctorProfileId String
        type            AvailabilityOverrideType
        startsAt        DateTime
        endsAt          DateTime
        reason          String?
        createdAt       DateTime                 @default(now())
        updatedAt       DateTime                 @updatedAt

        doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

        @@index([doctorProfileId, startsAt, endsAt])
}

model AppointmentOffer {
        id              String                 @id @default(cuid())
        waitlistEntryId String
        doctorServiceId String
        startsAt        DateTime
        endsAt          DateTime
        status          AppointmentOfferStatus @default(PENDING)
        expiresAt       DateTime
        respondedAt     DateTime?
        createdAt       DateTime               @default(now())
        updatedAt       DateTime               @updatedAt

        waitlistEntry WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict)

        doctorService DoctorService @relation(fields: [doctorServiceId], references: [id], onDelete: Restrict)

        @@index([waitlistEntryId, status])
        @@index([status, expiresAt])
        @@index([doctorServiceId, startsAt, endsAt])
}
