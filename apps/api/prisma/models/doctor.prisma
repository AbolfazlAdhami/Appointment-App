model DoctorProfile {
  id                      String                     @id @default(cuid())
  userId                  String                     @unique
  headline                String?
  shortIntroduction       String?
  biography               String?
  yearsOfExperience       Int?
  videoUrl                String?
  verificationStatus      DoctorVerificationStatus   @default(DRAFT)
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedById            String?
  reviewNote              String?
  isPublished             Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy              User?                      @relation("DoctorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  specialties             DoctorSpecialty[]
  credentials             DoctorCredential[]
  services                DoctorService[]
  weeklyAvailability      DoctorWeeklyAvailability[]
  availabilityOverrides   AvailabilityOverride[]
  appointments            Appointment[]
  waitlistEntries         WaitlistEntry[]
  visitRecords            VisitRecord[]
  followUpRecommendations FollowUpRecommendation[]
  wallet                  DoctorWallet?
  clinicMemberships       ClinicMembership[]

  @@index([verificationStatus, isPublished])
}

model Specialty {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  doctors     DoctorSpecialty[]

  @@index([isActive, name])
}

model DoctorSpecialty {
  id              String        @id @default(cuid())
  doctorProfileId String
  specialtyId     String
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([doctorProfileId, specialtyId])
  @@index([specialtyId, isPrimary])
}

model DoctorCredential {
  id               String                   @id @default(cuid())
  doctorProfileId  String
  fileAssetId      String
  type             DoctorCredentialType
  status           CredentialStatus         @default(PENDING_REVIEW)
  credentialNumber String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  submittedAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  doctorProfile    DoctorProfile            @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  fileAsset        FileAsset                @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  reviews          DoctorCredentialReview[]

  @@index([doctorProfileId, status])
  @@index([type, status])
}

model DoctorCredentialReview {
  id           String                   @id @default(cuid())
  credentialId String
  reviewerId   String
  decision     CredentialReviewDecision
  note         String?
  createdAt    DateTime                 @default(now())
  credential   DoctorCredential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  reviewer     User                     @relation("CredentialReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([credentialId, createdAt])
  @@index([reviewerId, createdAt])
}

model DoctorService {
  id                   String               @id @default(cuid())
  doctorProfileId      String
  name                 String
  description          String?
  appointmentType      AppointmentType      @default(REGULAR)
  consultationMode     ConsultationMode
  durationMinutes      Int
  price                Decimal              @db.Decimal(12, 2)
  currency             String               @default("IRR")
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  doctorProfile        DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  appointments         Appointment[]
  waitlistEntries      WaitlistEntry[]
  offers               AppointmentOffer[]
  feePolicies          PlatformFeePolicy[]
  cancellationPolicies CancellationPolicy[]

  @@index([doctorProfileId, isActive])
  @@index([doctorProfileId, appointmentType])
}

model DoctorWeeklyAvailability {
  id              String        @id @default(cuid())
  doctorProfileId String
  dayOfWeek       DayOfWeek
  startMinute     Int
  endMinute       Int
  timezone        String        @default("Asia/Tehran")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  @@index([doctorProfileId, dayOfWeek, isActive])
}

model AvailabilityOverride {
  id              String                   @id @default(cuid())
  doctorProfileId String
  type            AvailabilityOverrideType
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  doctorProfile   DoctorProfile            @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  @@index([doctorProfileId, startsAt, endsAt])
}

model Clinic {
  id          String             @id @default(cuid())
  name        String
  phone       String?
  address     String?
  city        String?
  province    String?
  postalCode  String?
  latitude    Decimal?           @db.Decimal(10, 7)
  longitude   Decimal?           @db.Decimal(10, 7)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships ClinicMembership[]

  @@index([city, isActive])
}

model ClinicMembership {
  id              String               @id @default(cuid())
  clinicId        String
  doctorProfileId String
  role            ClinicMembershipRole @default(STAFF)
  isPrimary       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  clinic          Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctorProfile   DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  @@unique([clinicId, doctorProfileId])
  @@index([doctorProfileId, isPrimary])
}
