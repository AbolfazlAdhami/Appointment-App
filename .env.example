# Local development PostgreSQL (docker-compose.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=pezeshki
POSTGRES_USER=pezeshki
# Change this local-only value before exposing the database beyond localhost.
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5433

# Local S3-compatible development service is available at http://127.0.0.1:4566.